[Unit]
Description=Membership Platform API (FastAPI)
After=network.target postgresql.service

[Service]
User=membership
WorkingDirectory=/opt/membership/backend
EnvironmentFile=/etc/membership/backend.env
ExecStart=/opt/membership/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure

[Install]
WantedBy=multi-user.target
