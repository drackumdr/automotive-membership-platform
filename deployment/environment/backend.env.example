# Copia este archivo a backend/.env y ajusta los valores. NUNCA subas .env al repositorio.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/membership_dev
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:8080,http://localhost:5000
TIMEZONE=America/Chihuahua
